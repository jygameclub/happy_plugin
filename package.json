{
  "name": "happy-plugin",
  "version": "1.0.0",
  "description": "Happy Plugin Debug Console for multi-terminal environments",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "vitest related --run"
    ]
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/jsdom": "^27.0.0",
    "@vitest/coverage-v8": "^1.4.0",
    "husky": "^9.0.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^15.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
